{$DOMAIN} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://raw.githubusercontent.com; worker-src 'self'; manifest-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
	}
}
