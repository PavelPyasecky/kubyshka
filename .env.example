# Домен, на котором живёт приложение. Caddy выпустит сертификат автоматически.
DOMAIN=kubyshka.example.com

# Пароль базы. Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# Необязательно. Если задан, при создании первой семьи приложение спросит этот код.
# Нужен, только если сервер смотрит в интернет заметное время до вашего первого входа.
SETUP_CODE=

# Выключать только для локальной разработки без HTTPS.
COOKIE_SECURE=true
